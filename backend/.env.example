PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://khetgpt:khetgpt@localhost:5432/khetgpt
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://localhost:8001

# "offline" serves backend/config/reference.dev.json instead of calling the
# ML service, so the frontend can be built without the ml/ container running.
ML_MODE=online